# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-long-random-local-secret-key-32-plus
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Docker)
DB_NAME=ai_developer
DB_USER=ai_developer
DB_PASSWORD=ai_developer
DB_HOST=localhost
DB_PORT=5432

# Google Cloud / Vertex AI (Joblynk service account)
# Copy your Joblynk JSON key to ai_module/credentials/google-service-account.json
# or point directly at the file you already have in ai_module/.
GOOGLE_APPLICATION_CREDENTIALS=ai_module/credentials/google-service-account.json
GOOGLE_CLOUD_PROJECT=joblynk-489820
GOOGLE_CLOUD_LOCATION=global
AI_MODEL_NAME=Gemini-3.5
AI_LLM_RETRY_ATTEMPTS=4
AI_LLM_RETRY_BASE_SECONDS=2
AI_LLM_RETRY_MAX_SECONDS=30

# AI coding agent API (FastAPI in ai_module/)
AI_AGENT_API_URL=http://localhost:8001
AI_AGENT_PUBLIC_URL=http://localhost:8001
AI_AGENT_WS_PUBLIC_URL=ws://localhost:8001/ws/chat

# Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:8011
NEXT_PUBLIC_AI_AGENT_URL=http://localhost:8001

# ── Tiered Context Strategy ─────────────────────────────────────────────────
# Token threshold at which session history is auto-compacted (default 100 000)
CONTEXT_COMPACT_THRESHOLD=100000
# How many most-recent messages to keep verbatim after compaction (default 6)
CONTEXT_COMPACT_KEEP_LAST=6
# Max file size (bytes) the /file/summarize endpoint will accept (default 512 KB)
SUMMARIZE_MAX_FILE_BYTES=524288
# Gemini model used for fast structural summaries (Gemini 2.5 Flash by default)
AI_SUMMARY_MODEL=gemini-2.5-flash
# Frontend threshold mirror (must match CONTEXT_COMPACT_THRESHOLD)
NEXT_PUBLIC_CONTEXT_COMPACT_THRESHOLD=100000
